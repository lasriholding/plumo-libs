{
  "name": "@plumo/nest",
  "version": "0.1.0",
  "description": "DRF-like Nest org-scoped CRUD: resources, filters, approvals, nested children",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external @nestjs/common --external class-validator --external class-transformer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "class-transformer": ">=0.5",
    "class-validator": ">=0.14",
    "reflect-metadata": ">=0.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plumo/plumo-libs.git",
    "directory": "packages/nest"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
